<UserControl x:Class="Sentinel.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Sentinel.App.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,6,22,24">
            <TextBlock Style="{StaticResource H1}" Text="Дашборд" />
            <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,18" Text="Состояние защиты, нагрузка системы и процессы, требующие внимания" />

            <!-- Индикатор защиты -->
            <Border Style="{StaticResource Card}" Padding="20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="58" Height="58" CornerRadius="29">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource WarnSoftBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status.RealtimeEnabled}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource OkSoftBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="&#xE83D;" FontSize="26">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Glyph}">
                                    <Setter Property="Foreground" Value="{StaticResource WarnBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Status.RealtimeEnabled}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource OkBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="18,0,18,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ProtectionTitle}" FontFamily="{StaticResource DisplayFont}" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource Muted}" Margin="0,5,0,0" TextWrapping="Wrap" Text="{Binding ProtectionDetail}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding RealtimeEnabled, Mode=TwoWay}" Content="Защита" Margin="0,0,20,0"
                                  ToolTip="Включить или приостановить защиту в реальном времени" />
                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding QuickScanCommand}" Content="Быстрая проверка" />
                        <Button Margin="10,0,0,0" Command="{Binding FullScanCommand}" Content="Полная проверка" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Базы угроз -->
            <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="20,14">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding UpdateDatabasesCommand}" Content="Обновить базы" />
                        <Button Style="{StaticResource GhostButton}" Margin="10,0,0,0" Command="{Binding OpenSettingsCommand}" Content="Настройки и базы" />
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource Glyph}" Text="&#xE8F1;" FontSize="22" Foreground="{StaticResource InfoBrush}" Margin="0,0,16,0" VerticalAlignment="Center" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding DatabaseTitle}" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" FontSize="15" />
                        <TextBlock Style="{StaticResource Muted}" Margin="0,3,0,0" TextWrapping="Wrap" Text="{Binding DatabaseDetail}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Счётчики -->
            <UniformGrid Columns="4" Margin="-6,12,-6,0">
                <Border Style="{StaticResource Card}" Margin="6">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Label}" Text="ПРОВЕРЕНО ФАЙЛОВ" />
                        <TextBlock Style="{StaticResource BigNumber}" Margin="0,6,0,0" Text="{Binding Status.FilesChecked, StringFormat={}{0:N0}}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="6">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Label}" Text="ПРОВЕРЕНО ПРОЦЕССОВ" />
                        <TextBlock Style="{StaticResource BigNumber}" Margin="0,6,0,0" Text="{Binding Status.ProcessesChecked, StringFormat={}{0:N0}}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="6">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Label}" Text="ИЗОЛИРОВАНО В КАРАНТИНЕ" />
                        <TextBlock Style="{StaticResource BigNumber}" Margin="0,6,0,0" Text="{Binding Status.Quarantined, StringFormat={}{0:N0}}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="6">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Label}" Text="ЖДУТ РЕШЕНИЯ" />
                        <TextBlock Margin="0,6,0,0" Text="{Binding Status.PendingDecisions, StringFormat={}{0:N0}}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource BigNumber}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Status.PendingDecisions, Converter={StaticResource BoolToVis}}" Value="Visible">
                                            <Setter Property="Foreground" Value="{StaticResource WarnBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Живые графики -->
            <UniformGrid Columns="3" Margin="-6,0,-6,0">
                <Border Style="{StaticResource Card}" Margin="6">
                    <StackPanel>
                        <DockPanel LastChildFill="False">
                            <TextBlock Style="{StaticResource Label}" Text="ПРОЦЕССОР" VerticalAlignment="Center" />
                            <TextBlock DockPanel.Dock="Right" Text="{Binding CpuText}" FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="SemiBold" />
                        </DockPanel>
                        <controls:LineChart Height="92" Margin="0,10,0,0" Values="{Binding Cpu}" Stroke="{StaticResource AccentBrush}" />
                        <TextBlock Style="{StaticResource Muted}" FontSize="11" Margin="0,8,0,0" Text="Загрузка всех ядер, последние 60 секунд" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="6">
                    <StackPanel>
                        <DockPanel LastChildFill="False">
                            <TextBlock Style="{StaticResource Label}" Text="ПАМЯТЬ" VerticalAlignment="Center" />
                            <TextBlock DockPanel.Dock="Right" Text="{Binding RamText}" FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="SemiBold" />
                        </DockPanel>
                        <controls:LineChart Height="92" Margin="0,10,0,0" Values="{Binding Ram}" Stroke="{StaticResource VioletBrush}" />
                        <TextBlock Style="{StaticResource Muted}" FontSize="11" Margin="0,8,0,0" Text="{Binding RamDetail, Converter={StaticResource Dash}}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="6">
                    <StackPanel>
                        <DockPanel LastChildFill="False">
                            <TextBlock Style="{StaticResource Label}" Text="ДИСК" VerticalAlignment="Center" />
                            <TextBlock DockPanel.Dock="Right" Text="{Binding DiskText}" FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="SemiBold" />
                        </DockPanel>
                        <controls:LineChart Height="92" Margin="0,10,0,0" Values="{Binding Disk}" Stroke="{StaticResource OkBrush}" />
                        <TextBlock Style="{StaticResource Muted}" FontSize="11" Margin="0,8,0,0" Text="Время активности физических дисков" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Процессы -->
            <DockPanel Margin="0,16,0,10" LastChildFill="False">
                <TextBlock Style="{StaticResource H2}" Text="Процессы с высокой нагрузкой или замечаниями" VerticalAlignment="Center" />
                <Button DockPanel.Dock="Right" Style="{StaticResource SmallButton}" Command="{Binding RefreshProcessesCommand}" Content="Обновить" />
            </DockPanel>
            <DataGrid ItemsSource="{Binding Processes}" MaxHeight="360" Visibility="{Binding HasProcesses, Converter={StaticResource BoolToVis}}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="70" />
                    <DataGridTextColumn Header="Процесс" Binding="{Binding Name}" Width="190" />
                    <DataGridTextColumn Header="ЦП" Binding="{Binding CpuPercent, StringFormat={}{0:0.0} %}" Width="80" />
                    <DataGridTemplateColumn Header="Критичность" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Pill}" Background="{Binding Severity, Converter={StaticResource SeverityBrush}, ConverterParameter=soft}"
                                        Visibility="{Binding Remarks, Converter={StaticResource BoolToVis}}">
                                    <TextBlock FontSize="11.5" Text="{Binding Severity, Converter={StaticResource SeverityText}}"
                                               Foreground="{Binding Severity, Converter={StaticResource SeverityBrush}}" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Замечания и путь" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Remarks}" ToolTip="{Binding Remarks}" Visibility="{Binding Remarks, Converter={StaticResource BoolToVis}}" />
                                    <TextBlock Style="{StaticResource Muted}" FontSize="11.5" Text="{Binding Path, Converter={StaticResource Dash}}" ToolTip="{Binding Path}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
            <Border Style="{StaticResource Card}" Visibility="{Binding HasProcesses, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                <TextBlock Style="{StaticResource Muted}" Text="Нагруженных процессов и процессов с замечаниями нет." />
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
