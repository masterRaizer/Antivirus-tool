<Window x:Class="Sentinel.App.Views.DecisionPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sentinel — требуется решение" Width="420" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        Foreground="{StaticResource TextBrush}" FontFamily="{StaticResource UiFont}" FontSize="13" UseLayoutRounding="True">
    <Border Margin="12" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource WarnBrush}" BorderThickness="1" CornerRadius="12" Padding="18,16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.55" Color="Black" />
        </Border.Effect>
        <StackPanel>
            <DockPanel LastChildFill="False">
                <Border Width="30" Height="30" CornerRadius="15" Background="{StaticResource WarnSoftBrush}">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE7BA;" Foreground="{StaticResource WarnBrush}" />
                </Border>
                <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Спорный объект" FontFamily="{StaticResource DisplayFont}" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource Muted}" FontSize="11.5" Text="Sentinel не уверен — решите, что с ним делать" />
                </StackPanel>
                <Button AutomationProperties.Name="Решить позже" DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Padding="8,3" BorderThickness="0" VerticalAlignment="Top"
                        Command="{Binding LaterCommand}" Content="&#xE8BB;" FontFamily="{StaticResource IconFont}" FontSize="10" ToolTip="Решить позже" />
            </DockPanel>

            <TextBlock Margin="0,14,0,0" FontSize="14" FontWeight="SemiBold" Text="{Binding Current.Name}" ToolTip="{Binding Current.Name}" />
            <TextBlock Style="{StaticResource Mono}" Margin="0,4,0,0" FontSize="11.5" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                       TextTrimming="None" Text="{Binding Current.Path, Converter={StaticResource Dash}}" />
            <Border Margin="0,10,0,0" Padding="11,8" CornerRadius="7" Background="{StaticResource BgBrush}">
                <TextBlock TextWrapping="Wrap" FontSize="12.5" MaxHeight="96">
                    <Run Text="Причина: " Foreground="{StaticResource MutedBrush}" />
                    <Run Text="{Binding Current.Reason, Mode=OneWay}" />
                </TextBlock>
            </Border>

            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button AutomationProperties.Name="В карантин" AutomationProperties.AutomationId="QuarantineButton" Style="{StaticResource DangerButton}" Command="{Binding QuarantineCommand}" Content="В карантин" />
                <Button AutomationProperties.Name="В исключения" AutomationProperties.AutomationId="AllowButton" Grid.Column="2" Command="{Binding AllowCommand}" Content="В исключения" />
            </Grid>
            <TextBlock Style="{StaticResource Muted}" Margin="0,10,0,0" FontSize="11.5" TextWrapping="Wrap" Text="{Binding QueueText}" />
        </StackPanel>
    </Border>
</Window>
