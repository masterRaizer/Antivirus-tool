<UserControl x:Class="Sentinel.App.Views.QuarantineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="28,6,22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <DockPanel LastChildFill="False" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Style="{StaticResource H1}" Text="Карантин и откат" />
                <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0" Text="Любое действие Sentinel обратимо: файл возвращается на место, параметр — к прежнему значению" />
            </StackPanel>
            <Button AutomationProperties.Name="Обновить" DockPanel.Dock="Right" VerticalAlignment="Center" Command="{Binding RefreshCommand}" Content="Обновить" />
        </DockPanel>

        <TabControl Grid.Row="1">
            <TabItem Header="{Binding FilesHeader}">
                <Grid>
                    <DataGrid ItemsSource="{Binding Files}" Visibility="{Binding NoFiles, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Изолирован" Binding="{Binding QuarantinedAtUtc, Converter={StaticResource LocalTime}}" Width="150" />
                            <DataGridTemplateColumn Header="Исходный путь и SHA-256" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding OriginalPath}" ToolTip="{Binding OriginalPath}" />
                                            <TextBlock Style="{StaticResource Mono}" FontSize="11" Foreground="{StaticResource MutedBrush}" Text="{Binding Sha256}" ToolTip="{Binding Sha256}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Размер" Binding="{Binding Size, Converter={StaticResource Bytes}}" Width="90" />
                            <DataGridTemplateColumn Header="Причина" Width="230">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Reason}" ToolTip="{Binding Reason}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Действие" Width="250">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <StackPanel Orientation="Horizontal" Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}">
                                                <Button AutomationProperties.Name="Восстановить" Style="{StaticResource SmallButton}" Content="Восстановить"
                                                        ToolTip="Вернуть файл на исходное место с проверкой SHA-256"
                                                        Command="{Binding DataContext.RestoreCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" />
                                                <Button AutomationProperties.Name="Удалить навсегда" Style="{StaticResource SmallButton}" Margin="8,0,0,0" Content="Удалить навсегда" Foreground="{StaticResource DangerBrush}"
                                                        ToolTip="Стереть изолированный файл без возможности восстановления"
                                                        Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" />
                                            </StackPanel>
                                            <TextBlock Style="{StaticResource Muted}" VerticalAlignment="Center"
                                                       Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                                                <Run Text="{Binding StateText, Mode=OneWay}" />
                                                <Run Text="{Binding RestoredAtUtc, Converter={StaticResource LocalTime}, Mode=OneWay}" />
                                            </TextBlock>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Border Style="{StaticResource Card}" VerticalAlignment="Top" Visibility="{Binding NoFiles, Converter={StaticResource BoolToVis}}">
                        <TextBlock Style="{StaticResource Muted}" Text="Карантин пуст: quarantine_manifest.json не содержит записей." />
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="{Binding RollbackHeader}">
                <Grid>
                    <DataGrid ItemsSource="{Binding Rollback}" Visibility="{Binding NoRollback, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Изменено" Binding="{Binding TimestampUtc, Converter={StaticResource LocalTime}}" Width="150" />
                            <DataGridTextColumn Header="Тип" Binding="{Binding Kind}" Width="130" />
                            <DataGridTemplateColumn Header="Параметр" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Target}" ToolTip="{Binding Target}" />
                                            <TextBlock Style="{StaticResource Muted}" FontSize="11.5" Text="{Binding Name, Converter={StaticResource Dash}}" ToolTip="{Binding Name}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Было → стало" Width="260">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource Mono}" FontSize="11.5" Text="{Binding PreviousValue, Converter={StaticResource Dash}}" ToolTip="{Binding PreviousValue}" />
                                            <TextBlock Style="{StaticResource Mono}" FontSize="11.5" Foreground="{StaticResource MutedBrush}"
                                                       Text="{Binding NewValue, Converter={StaticResource Dash}, StringFormat=→ {0}}" ToolTip="{Binding NewValue}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Действие" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Button AutomationProperties.Name="Вернуть" Style="{StaticResource SmallButton}" Content="Вернуть" HorizontalAlignment="Left"
                                                    ToolTip="Вернуть параметру прежнее значение из rollback_manifest.json"
                                                    Visibility="{Binding Undone, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"
                                                    Command="{Binding DataContext.UndoCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" />
                                            <TextBlock Style="{StaticResource Muted}" VerticalAlignment="Center" Text="Возвращено"
                                                       Visibility="{Binding Undone, Converter={StaticResource BoolToVis}}" />
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Border Style="{StaticResource Card}" VerticalAlignment="Top" Visibility="{Binding NoRollback, Converter={StaticResource BoolToVis}}">
                        <TextBlock Style="{StaticResource Muted}" Text="Изменений конфигурации не было: rollback_manifest.json не содержит записей." />
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
