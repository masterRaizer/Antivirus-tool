<Window x:Class="Sentinel.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Sentinel.App.Views"
        Title="Sentinel" Width="1280" Height="820" MinWidth="1080" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13" UseLayoutRounding="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border Background="{StaticResource BgBrush}">
        <Border.Style>
            <Style TargetType="Border">
                <!-- Развёрнутое окно с WindowChrome выходит за границы экрана на толщину рамки. -->
                <Style.Triggers>
                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                        <Setter Property="Padding" Value="7" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
                <RowDefinition Height="32" />
            </Grid.RowDefinitions>

            <!-- Боковая панель -->
            <Border Grid.RowSpan="3" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <DockPanel Margin="14,14,14,14">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,2,0,22">
                        <Border Width="34" Height="34" CornerRadius="9" Background="{StaticResource AccentSoftBrush}">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE83D;" FontSize="18" Foreground="{StaticResource AccentBrush}" />
                        </Border>
                        <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Sentinel" FontFamily="{StaticResource DisplayFont}" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource Muted}" FontSize="11" Text="{Binding Version, StringFormat=версия {0}}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Режим работы -->
                    <Border DockPanel.Dock="Bottom" Background="{StaticResource BgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="9" Padding="12,10" ToolTip="{Binding ModeDetail}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Label}" Text="РЕЖИМ РАБОТЫ" />
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{StaticResource InfoBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsServiceMode}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource OkBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Margin="8,0,0,0" Text="{Binding ModeTitle}" FontWeight="SemiBold" />
                            </StackPanel>
                            <Button AutomationProperties.Name="Запустить службу" Style="{StaticResource SmallButton}" Margin="0,10,0,0" HorizontalAlignment="Stretch"
                                    Command="{Binding StartServiceCommand}" Content="Запустить службу"
                                    ToolTip="sc.exe start SentinelService (потребуются права администратора). Подключение произойдёт автоматически."
                                    Visibility="{Binding IsServiceMode, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                        </StackPanel>
                    </Border>

                    <StackPanel>
                        <RadioButton Style="{StaticResource NavItem}" GroupName="Nav"
                                     IsChecked="{Binding Section, Converter={StaticResource EnumMatch}, ConverterParameter=Dashboard}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE80F;" Width="22" />
                                <TextBlock Margin="10,0,0,0" Text="Дашборд" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavItem}" GroupName="Nav"
                                     IsChecked="{Binding Section, Converter={StaticResource EnumMatch}, ConverterParameter=Scan}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE721;" Width="22" />
                                <TextBlock Margin="10,0,0,0" Text="Сканирование" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavItem}" GroupName="Nav"
                                     IsChecked="{Binding Section, Converter={StaticResource EnumMatch}, ConverterParameter=Threats}">
                            <DockPanel LastChildFill="False" Width="190">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE7BA;" Width="22" />
                                <TextBlock Margin="10,0,0,0" Text="Угрозы и события" VerticalAlignment="Center" />
                                <Border DockPanel.Dock="Right" Background="{StaticResource WarnBrush}" CornerRadius="9" MinWidth="18" Padding="5,1"
                                        VerticalAlignment="Center" Visibility="{Binding PendingCount, Converter={StaticResource BoolToVis}}"
                                        ToolTip="Находки, ожидающие вашего решения">
                                    <TextBlock Text="{Binding PendingCount}" Foreground="#0F1117" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" />
                                </Border>
                            </DockPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavItem}" GroupName="Nav"
                                     IsChecked="{Binding Section, Converter={StaticResource EnumMatch}, ConverterParameter=Quarantine}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE72E;" Width="22" />
                                <TextBlock Margin="10,0,0,0" Text="Карантин и откат" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavItem}" GroupName="Nav"
                                     IsChecked="{Binding Section, Converter={StaticResource EnumMatch}, ConverterParameter=Startup}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE7E8;" Width="22" />
                                <TextBlock Margin="10,0,0,0" Text="Автозагрузка и службы" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavItem}" GroupName="Nav"
                                     IsChecked="{Binding Section, Converter={StaticResource EnumMatch}, ConverterParameter=Reports}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE8A5;" Width="22" />
                                <TextBlock Margin="10,0,0,0" Text="История отчётов" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavItem}" GroupName="Nav"
                                     IsChecked="{Binding Section, Converter={StaticResource EnumMatch}, ConverterParameter=Behavioral}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE945;" Width="22" />
                                <TextBlock Margin="10,0,0,0" Text="Поведенческий щит и USB" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavItem}" GroupName="Nav"
                                     IsChecked="{Binding Section, Converter={StaticResource EnumMatch}, ConverterParameter=Settings}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE713;" Width="22" />
                                <TextBlock Margin="10,0,0,0" Text="Настройки и базы" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Заголовок окна -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button AutomationProperties.Name="Свернуть" Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="OnMinimize" ToolTip="Свернуть" />
                <Button AutomationProperties.Name="Развернуть или восстановить" Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="OnMaximize" ToolTip="Развернуть или восстановить" />
                <Button AutomationProperties.Name="Свернуть в трей" Style="{StaticResource CaptionCloseButton}" Content="&#xE8BB;" Click="OnClose" ToolTip="Свернуть в трей" />
            </StackPanel>

            <!-- Разделы -->
            <Grid Grid.Column="1" Grid.Row="1">
                <views:DashboardView DataContext="{Binding Dashboard}"
                                     Visibility="{Binding DataContext.Section, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumToVis}, ConverterParameter=Dashboard}" />
                <views:ScanView DataContext="{Binding Scan}"
                                Visibility="{Binding DataContext.Section, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumToVis}, ConverterParameter=Scan}" />
                <views:ThreatsView DataContext="{Binding Threats}"
                                   Visibility="{Binding DataContext.Section, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumToVis}, ConverterParameter=Threats}" />
                <views:QuarantineView DataContext="{Binding Quarantine}"
                                      Visibility="{Binding DataContext.Section, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumToVis}, ConverterParameter=Quarantine}" />
                <views:StartupView DataContext="{Binding Startup}"
                                   Visibility="{Binding DataContext.Section, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumToVis}, ConverterParameter=Startup}" />
                <views:ReportsView DataContext="{Binding Reports}"
                                   Visibility="{Binding DataContext.Section, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumToVis}, ConverterParameter=Reports}" />
                <views:BehavioralView DataContext="{Binding Behavioral}"
                                      Visibility="{Binding DataContext.Section, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumToVis}, ConverterParameter=Behavioral}" />
                <views:SettingsView DataContext="{Binding Settings}"
                                    Visibility="{Binding DataContext.Section, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumToVis}, ConverterParameter=Settings}" />
            </Grid>

            <!-- Строка состояния -->
            <Border Grid.Column="1" Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="28,0">
                <TextBlock VerticalAlignment="Center" FontSize="12" Text="{Binding StatusMessage}" ToolTip="{Binding StatusMessage}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource CriticalBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>
        </Grid>
    </Border>
</Window>
