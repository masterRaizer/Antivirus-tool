<UserControl x:Class="Sentinel.App.Views.ThreatsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="28,6,16,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Style="{StaticResource H1}" Text="Угрозы и события" />
            <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,14" Text="{Binding Summary}" />
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,14">
            <RadioButton Style="{StaticResource Chip}" GroupName="ThreatFilter" Content="Требуют решения"
                         IsChecked="{Binding Filter, Converter={StaticResource EnumMatch}, ConverterParameter=Pending}" />
            <RadioButton Style="{StaticResource Chip}" GroupName="ThreatFilter" Content="Нейтрализованные"
                         IsChecked="{Binding Filter, Converter={StaticResource EnumMatch}, ConverterParameter=Neutralized}" />
            <RadioButton Style="{StaticResource Chip}" GroupName="ThreatFilter" Content="Журнал и инфо"
                         IsChecked="{Binding Filter, Converter={StaticResource EnumMatch}, ConverterParameter=Journal}" />
            <RadioButton Style="{StaticResource Chip}" GroupName="ThreatFilter" Content="Все"
                         IsChecked="{Binding Filter, Converter={StaticResource EnumMatch}, ConverterParameter=All}" />
        </StackPanel>

        <ListBox Grid.Row="2" Style="{StaticResource CardList}" ItemsSource="{Binding View}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="5" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border CornerRadius="9,0,0,9" Background="{Binding Severity, Converter={StaticResource SeverityBrush}}" />
                            <StackPanel Grid.Column="1" Margin="18,14,18,16">
                                <!-- Заголовок карточки -->
                                <DockPanel LastChildFill="False">
                                    <TextBlock Style="{StaticResource H2}" FontSize="15.5" Text="{Binding Name}" VerticalAlignment="Center" MaxWidth="520" ToolTip="{Binding Name}" />
                                    <Border Style="{StaticResource Pill}" Margin="12,0,0,0" Background="{Binding Severity, Converter={StaticResource SeverityBrush}, ConverterParameter=soft}">
                                        <TextBlock FontSize="11.5" FontWeight="SemiBold" Text="{Binding Severity, Converter={StaticResource SeverityText}}"
                                                   Foreground="{Binding Severity, Converter={StaticResource SeverityBrush}}" />
                                    </Border>
                                    <Border Style="{StaticResource Pill}" Margin="8,0,0,0">
                                        <TextBlock FontSize="11.5" Foreground="{StaticResource MutedBrush}" Text="{Binding Kind, Converter={StaticResource ThreatKindText}}" />
                                    </Border>
                                    <Border Style="{StaticResource Pill}" DockPanel.Dock="Right" HorizontalAlignment="Right"
                                            Background="{Binding Status, Converter={StaticResource ThreatStatusBrush}, ConverterParameter=soft}">
                                        <TextBlock FontSize="11.5" FontWeight="SemiBold" Text="{Binding Status, Converter={StaticResource ThreatStatusText}}"
                                                   Foreground="{Binding Status, Converter={StaticResource ThreatStatusBrush}}" />
                                    </Border>
                                </DockPanel>

                                <!-- Подробности -->
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Style="{StaticResource Muted}" Margin="0,3" Text="Полный путь" />
                                    <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource SelectableText}" Margin="0,3" Text="{Binding Path, Mode=OneWay, Converter={StaticResource Dash}}" />
                                    <TextBlock Grid.Row="1" Style="{StaticResource Muted}" Margin="0,3" Text="SHA-256" />
                                    <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource SelectableText}" Margin="0,3" Text="{Binding Sha256, Mode=OneWay, Converter={StaticResource Dash}}" />
                                    <TextBlock Grid.Row="2" Style="{StaticResource Muted}" Margin="0,3" Text="Энтропия Шеннона" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,3" FontSize="12.5" Text="{Binding Entropy, Converter={StaticResource Entropy}}" />
                                    <TextBlock Grid.Row="3" Style="{StaticResource Muted}" Margin="0,3" Text="Цифровая подпись" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,3" FontSize="12.5" TextWrapping="Wrap" Text="{Binding SignatureStatus}" />
                                    <TextBlock Grid.Row="4" Style="{StaticResource Muted}" Margin="0,3" Text="Причина срабатывания" />
                                    <TextBlock Grid.Row="4" Grid.Column="1" Margin="0,3" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding Reason}" />
                                    <TextBlock Grid.Row="5" Style="{StaticResource Muted}" Margin="0,3" Text="Описание" />
                                    <TextBlock Grid.Row="5" Grid.Column="1" Margin="0,3" FontSize="12.5" TextWrapping="Wrap" Text="{Binding Description, Converter={StaticResource Dash}}" />
                                    <TextBlock Grid.Row="6" Style="{StaticResource Muted}" Margin="0,3" Text="Обнаружено" />
                                    <TextBlock Grid.Row="6" Grid.Column="1" Margin="0,3" FontSize="12.5">
                                        <Run Text="{Binding DetectedAtUtc, Mode=OneWay, Converter={StaticResource LocalTime}}" />
                                        <Run Text=" · " />
                                        <Run Text="{Binding Source, Mode=OneWay, Converter={StaticResource ThreatSourceText}}" />
                                    </TextBlock>
                                </Grid>

                                <!-- Действие -->
                                <Border Margin="0,12,0,0" Padding="12,9" CornerRadius="7" Background="{StaticResource BgBrush}"
                                        Visibility="{Binding ActionMessage, Converter={StaticResource BoolToVis}}">
                                    <TextBlock FontSize="12.5" TextWrapping="Wrap">
                                        <Run Text="Статус действия: " Foreground="{StaticResource MutedBrush}" />
                                        <Run Text="{Binding ActionMessage, Mode=OneWay}" />
                                    </TextBlock>
                                </Border>
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0" Visibility="{Binding IsActionable, Converter={StaticResource BoolToVis}}">
                                    <Button Style="{StaticResource DangerButton}" Content="В карантин"
                                            ToolTip="Нейтрализовать: изолировать файл, завершить процесс или откатить параметр"
                                            Command="{Binding DataContext.QuarantineCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" />
                                    <Button Margin="10,0,0,0" Content="В исключения"
                                            ToolTip="Доверять объекту: добавить в allowed_exclusions.json и больше не сообщать о нём"
                                            Command="{Binding DataContext.AllowCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" />
                                    <Button Style="{StaticResource GhostButton}" Margin="10,0,0,0" Content="Игнорировать"
                                            ToolTip="Оставить без действий: событие уходит в журнал, объект не изменяется и не вносится в исключения"
                                            Command="{Binding DataContext.IgnoreCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Border Grid.Row="2" Style="{StaticResource Card}" VerticalAlignment="Top" Margin="0,0,12,0"
                Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <TextBlock Style="{StaticResource H2}" Text="Здесь пусто" />
                <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap"
                           Text="Находки защиты в реальном времени и проверок появятся в этом списке вместе с причиной срабатывания и итогом действия." />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
