<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">

  <Package Name="Sentinel"
           Manufacturer="Sentinel"
           Version="$(ProductVersion)"
           UpgradeCode="6B1F3C52-8D4A-4E7B-9A21-5C0E7D93F4A8"
           Scope="perMachine"
           Language="1033"
           InstallerVersion="500">

    <!-- Обновление поверх старой версии: старая удаляется, новая ставится; откат на более раннюю версию запрещён. -->
    <MajorUpgrade DowngradeErrorMessage="A newer version of Sentinel is already installed. Uninstall it first." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Sentinel">
        <Directory Id="RulesFolder" Name="rules" />
        <Directory Id="DataFolder" Name="data" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="SentinelMenuFolder" Name="Sentinel" />
    </StandardDirectory>
    <StandardDirectory Id="DesktopFolder" />

    <!-- Файлы .exe берутся из dist\, подготовленного scripts/publish-windows.ps1. -->
    <ComponentGroup Id="ProgramComponents" Directory="INSTALLFOLDER">
      <Component Id="AppExe" Bitness="always64">
        <File Id="SentinelAppExe" Source="$(DistDir)Sentinel.App.exe" KeyPath="yes" />
      </Component>

      <Component Id="ServiceExe" Bitness="always64">
        <File Id="SentinelServiceExe" Source="$(DistDir)Sentinel.Service.exe" KeyPath="yes" />
        <!-- Имя службы совпадает с ServiceOptions.ServiceName. Запуск — LocalSystem, автозапуск при загрузке. -->
        <ServiceInstall Id="SentinelServiceInstall"
                        Name="SentinelService"
                        DisplayName="Sentinel Realtime Protection"
                        Description="Sentinel realtime protection: file, process, startup and configuration auditing; threat database updates."
                        Type="ownProcess"
                        Start="auto"
                        ErrorControl="normal"
                        Account="LocalSystem"
                        Vital="yes" />
        <!-- Восстановление после сбоя (перезапуск через 5/30/60 с, сброс за сутки) служба выставляет себе сама при старте
             (Sentinel.Service/ServiceRecovery.cs). Таблица MsiServiceConfigFailureActions (ServiceConfigFailureActions) не используется:
             Windows Installer открывает службу без SERVICE_START, нужного для действий «restart», получает ACCESS_DENIED → ошибка 1939
             → откат всей установки (1603), что и случилось на Windows 11 24H2 в 1.3.0. -->
        <ServiceControl Id="SentinelServiceControl"
                        Name="SentinelService"
                        Start="install"
                        Stop="both"
                        Remove="uninstall"
                        Wait="yes" />
      </Component>

      <!-- Запуск SentinelService в Безопасном режиме (минимальном и с сетью): ключи SafeBoot со значением по умолчанию «Service».
           Удаляются вместе с программой. -->
      <Component Id="SafeBootRegistration" Bitness="always64">
        <RegistryKey Root="HKLM" Key="SYSTEM\CurrentControlSet\Control\SafeBoot\Minimal\SentinelService">
          <RegistryValue Type="string" Value="Service" KeyPath="yes" />
        </RegistryKey>
        <RegistryKey Root="HKLM" Key="SYSTEM\CurrentControlSet\Control\SafeBoot\Network\SentinelService">
          <RegistryValue Type="string" Value="Service" />
        </RegistryKey>
      </Component>

      <Component Id="CliExe" Bitness="always64">
        <File Id="SentinelCliExe" Source="$(DistDir)Sentinel.Cli.exe" KeyPath="yes" />
      </Component>

      <!-- Шаблон белого списка в каталоге программы. Рабочий список пользователя служба хранит в
           C:\ProgramData\Sentinel\allowed_exclusions.json: установщик этот каталог не создаёт, не перезаписывает
           и не удаляет, поэтому при обновлении 1.0.0 → 1.1.0 и при удалении программы пользовательские данные сохраняются. -->
      <Component Id="AllowedExclusions" Bitness="always64">
        <File Id="AllowedExclusionsJson" Source="$(DistDir)allowed_exclusions.json" KeyPath="yes" />
      </Component>

      <Component Id="ThirdPartyNotices" Bitness="always64">
        <File Id="ThirdPartyNoticesMd" Source="$(DistDir)THIRD_PARTY_NOTICES.md" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!-- Стартовая база угроз data\threat_hashes.bin (обновлённая копия ведётся службой в каталоге данных). -->
    <ComponentGroup Id="DataComponents" Directory="DataFolder">
      <Files Include="$(DistDir)data\**" />
    </ComponentGroup>

    <!-- Каталог rules\ копируется целиком (все файлы из dist\rules). -->
    <ComponentGroup Id="RulesComponents" Directory="RulesFolder">
      <Files Include="$(DistDir)rules\**" />
    </ComponentGroup>

    <ComponentGroup Id="ShortcutComponents">
      <Component Id="StartMenuShortcut" Directory="SentinelMenuFolder" Bitness="always64">
        <Shortcut Id="AppStartMenuShortcut"
                  Name="Sentinel"
                  Description="Sentinel - Windows protection and audit"
                  Target="[INSTALLFOLDER]Sentinel.App.exe"
                  WorkingDirectory="INSTALLFOLDER" />
        <RemoveFolder Id="RemoveStartMenuFolder" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\Sentinel\Installer" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>

      <Component Id="DesktopShortcut" Directory="DesktopFolder" Bitness="always64">
        <Shortcut Id="AppDesktopShortcut"
                  Name="Sentinel"
                  Description="Sentinel - Windows protection and audit"
                  Target="[INSTALLFOLDER]Sentinel.App.exe"
                  WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU" Key="Software\Sentinel\Installer" Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <Feature Id="Main" Title="Sentinel" Level="1">
      <ComponentGroupRef Id="ProgramComponents" />
      <ComponentGroupRef Id="RulesComponents" />
      <ComponentGroupRef Id="DataComponents" />
      <ComponentGroupRef Id="ShortcutComponents" />
    </Feature>

  </Package>
</Wix>
