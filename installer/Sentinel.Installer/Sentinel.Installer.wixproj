<Project Sdk="WixToolset.Sdk/5.0.2">

  <!-- Автономный проект: в Sentinel.sln не входит, чтобы кросс-сборка решения на Linux не требовала WiX.
       Собирается только на Windows: dotnet build installer/Sentinel.Installer/Sentinel.Installer.wixproj -c Release -p:ProductVersion=1.3.1
       Перед сборкой нужно выполнить scripts/publish-windows.ps1 (результат — каталог dist\). -->
  <PropertyGroup>
    <OutputName>Sentinel</OutputName>
    <OutputType>Package</OutputType>
    <Platform>x64</Platform>
    <InstallerPlatform>x64</InstallerPlatform>
    <SuppressValidation>false</SuppressValidation>
    <!-- Корневой Directory.Build.props включает TreatWarningsAsErrors для C#; для WiX (ICE-проверки) это не нужно. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <ProductVersion Condition="'$(ProductVersion)' == ''">1.3.1</ProductVersion>
    <DistDir Condition="'$(DistDir)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\dist\'))</DistDir>
    <DefineConstants>ProductVersion=$(ProductVersion);DistDir=$(DistDir)</DefineConstants>
  </PropertyGroup>

</Project>
